import QtQuick 2.9
import QtQuick.Controls 2.2
import QtQuick.Layouts 1.3

import "Theme.js" as Theme

// Product pairing dialog. The PIN is generated by ComputerModel and is shown
// here while the existing Sunshine pairing flow runs in the background.
Dialog {
    id: dialog

    property string pin: ""
    property string pcName: ""
    property bool busy: false
    property string errorText: ""

    modal: true
    anchors.centerIn: Overlay.overlay
    width: 420
    padding: 0
    closePolicy: Popup.NoAutoClose

    background: Rectangle {
        color: Theme.panel
        radius: Theme.radiusM
        border.width: 1
        border.color: Theme.accent
    }

    contentItem: ColumnLayout {
        spacing: Theme.spaceM

        Label {
            Layout.fillWidth: true
            text: dialog.pcName.length > 0
                  ? qsTr("Сопряжение с %1").arg(dialog.pcName)
                  : qsTr("Сопряжение с компьютером")
            color: Theme.text
            font.pointSize: Theme.fontTitle
            font.bold: true
            elide: Text.ElideRight
        }

        Label {
            Layout.fillWidth: true
            text: qsTr("Введите этот код на компьютере:")
            color: Theme.textMuted
            font.pointSize: Theme.fontBody
            wrapMode: Text.Wrap
        }

        Label {
            Layout.fillWidth: true
            text: dialog.pin
            color: Theme.accent
            font.pointSize: Theme.fontDisplay
            font.bold: true
            horizontalAlignment: Text.AlignHCenter
            font.letterSpacing: 6
        }

        RowLayout {
            Layout.fillWidth: true
            spacing: Theme.spaceM

            BusyIndicator {
                visible: dialog.busy
                running: dialog.busy
            }

            Label {
                Layout.fillWidth: true
                visible: dialog.busy && dialog.errorText.length === 0
                text: qsTr("Ожидаем подтверждение…")
                color: Theme.textMuted
                font.pointSize: Theme.fontSmall
            }

            Item { Layout.fillWidth: true }
        }

        Label {
            Layout.fillWidth: true
            visible: dialog.errorText.length > 0
            text: dialog.errorText
            color: Theme.error
            font.pointSize: Theme.fontBody
            wrapMode: Text.Wrap
        }
    }

    footer: RowLayout {
        spacing: Theme.spaceM

        Item { Layout.fillWidth: true }

        LegionButton {
            id: cancelButton
            kind: "secondary"
            text: qsTr("Отмена")
            onClicked: dialog.close()
        }
    }

    onOpened: cancelButton.forceActiveFocus(Qt.TabFocus)
}
